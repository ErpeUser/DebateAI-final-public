{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "debateai-site",
  "compatibility_date": "2026-07-01",
  "main": "worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "routes": [],
  "r2_buckets": [],
  "d1_databases": [],
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true,
  },
}
