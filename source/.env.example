# Set this for any deployment reachable beyond loopback. The browser bootstraps it once from /api/meta.
DEBATEAI_INSTANCE_TOKEN=replace-with-a-long-random-token

# Optional fallback -- you can instead add keys in Admin -> Connections
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional debate fact research. When enabled, short model-produced queries
# are sent to the public Wikimedia and DuckDuckGo Instant Answer endpoints.
# Privacy First disables this egress even when the setting is true.
# DEBATE_RESEARCH_ENABLED=false
# DEBATE_RESEARCH_TIMEOUT_SECONDS=4
# DEBATE_RESEARCH_COOLDOWN_SECONDS=45
# DEBATE_RESEARCH_MAX_SOURCES=4

# PyTorch wheel channel for the optional Sortformer diarizer.
# Default "auto": CUDA wheels only when an NVIDIA GPU is detected
# (nvidia-smi on PATH), otherwise the much smaller CPU wheels with
# identical CPU performance. Docker builds never see a GPU, so images
# get CPU wheels unless you set this explicitly. Accepts a shorthand
# channel ("cpu", "cu130", "rocm6.4") or a full index URL.
# PYTORCH_INDEX_URL=auto

# Database settings are optional: docker-compose.yml provides defaults for
# POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB and derives the backend
# DATABASE_URL from them. Uncomment only to override, and keep the values in
# sync with each other.
# POSTGRES_USER=debateai
# POSTGRES_PASSWORD=replace-with-a-long-random-password
# POSTGRES_DB=debateai
# DATABASE_URL=postgresql+asyncpg://debateai:changeme@db:5432/debateai

# Pin the Hugging Face NER model to an immutable commit in production.
PII_NER_MODEL_REVISION=replace-with-immutable-huggingface-commit
