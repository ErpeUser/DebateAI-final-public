# Permanent source in app/ is versioned. Generated and runtime are independent artifacts.
/DebateAI_Generated/
/runtime/
/.codex/
/.agents/

# Local evidence and generated reports must never be published from app/.
/app/docs/acceptance/
/app/.ai/
/app/ai/history/
**/.test-artifacts/
**/.test-artifacts-*/
**/artifacts/
**/benchmark-results/
**/test-results/

# Transient Python/Node dependencies, builds and test outputs.
__pycache__/
*.pyc
*.pyo
*.log
.DS_Store
node_modules/
dist/
build/
release-assets/
coverage/
.vite/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.release-venv/
.venv/
.tmp/

# Secrets, local environment variants and user databases (all folders).
# Only safe, explicitly non-secret templates belong in version control.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env
*.key
*.pem
*.p12
*.pfx
pgdata/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Downloaded native development resources.
/app/desktop/pgsql/
/app/desktop/ffmpeg/
/app/desktop/cliproxyapi/
/app/desktop/gemini_web_to_api/gemini-web-to-api.exe
/app/desktop/chatgpt_oracle/node/*
!/app/desktop/chatgpt_oracle/node/LICENSE.node
/app/desktop/chatgpt_oracle/node_modules/
/app/backend/models/

# Machine-only tool profiles, IDEs and local analysis outputs.
/marketing/
.claude/
/skills-lock.json
.worktrees/
.superpowers/
graphify-out/
.idea/
.vscode/
*.code-workspace
.tox/
.nox/
.cache/

.test-account-*/
