---
// Renders Starlight's default head, then appends per-page JSON-LD
// (TechArticle + BreadcrumbList) so docs pages carry the same entity
// anchors (#website / #organization) as the landing page's schema graph.
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, id } = Astro.locals.starlightRoute;
const isIndex = !id || id === 'index';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (path) => (siteUrl ? `${siteUrl}${path}` : path);
const pageUrl = absoluteUrl(`/docs/${isIndex ? '' : `${id.replace(/\/$/, '')}/`}`);
const page = {
  '@type': isIndex ? 'WebPage' : 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': absoluteUrl('/') + '#website' },
  publisher: { '@id': absoluteUrl('/') + '#organization' },
  author: { '@id': absoluteUrl('/') + '#organization' },
};
const crumbs = [
  { '@type': 'ListItem', position: 1, name: 'Debate AI', item: absoluteUrl('/') },
  isIndex
    ? { '@type': 'ListItem', position: 2, name: 'Docs' }
    : { '@type': 'ListItem', position: 2, name: 'Docs', item: absoluteUrl('/docs/') },
];
if (!isIndex) crumbs.push({ '@type': 'ListItem', position: 3, name: entry.data.title });
const graph = {
  '@context': 'https://schema.org',
  '@graph': [page, { '@type': 'BreadcrumbList', itemListElement: crumbs }],
};
---

<Default><slot /></Default>
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
