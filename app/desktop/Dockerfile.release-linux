# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS bundle
RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils libsndfile1 libx11-6 libxext6 libxrender1 libsm6 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY backend/requirements.txt backend/requirements.txt
COPY desktop/requirements.txt desktop/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt -r desktop/requirements.txt
COPY backend/ backend/
COPY desktop/ desktop/
COPY ai/ ai/
COPY --from=frontend /src/frontend/dist frontend/dist
RUN python backend/scripts/download_models.py
RUN rm -rf desktop/pgsql && python desktop/scripts/download_pg.py
RUN rm -rf desktop/ffmpeg && python desktop/scripts/download_ffmpeg.py
RUN python -m PyInstaller desktop/debateai.spec --distpath dist --workpath build --noconfirm
COPY --from=controller smoke_test.py /tmp/debateai-smoke-test.py
USER nobody
RUN python /tmp/debateai-smoke-test.py
USER root
RUN mkdir /out && tar -C dist -czf "/out/DebateAI-linux-x64.tar.gz" DebateAI
RUN install -d -o nobody build/native-smoke build/native-smoke-data
USER nobody
RUN python desktop/scripts/smoke_update_archive.py \
    --platform linux-x64 --archive /out/DebateAI-linux-x64.tar.gz
USER root

FROM scratch AS export
COPY --from=bundle /out/DebateAI-linux-x64.tar.gz /
